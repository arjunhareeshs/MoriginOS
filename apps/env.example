# MarginOS environment variables
# Copy this file to the repository root as ".env" and fill in the values. Never commit ".env".
# Every value below is a placeholder. Real credentials live only in .env and in Render.

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
# Random long string, used to sign sessions. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# --- Database ---
# docker-compose publishes Postgres on host port 5433 (5432 is often taken by a native install)
DATABASE_URL=postgresql+psycopg://marginos:marginos@localhost:5433/marginos
# Optional, only if a background worker is added
REDIS_URL=

# --- PayPal (sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled in after the webhook is registered (scripts/register_webhooks.py prints it)
PAYPAL_WEBHOOK_ID=
# Public URL PayPal posts events to (tunnel URL locally, Render URL in production)
PAYPAL_WEBHOOK_URL=
# Sandbox business account email, shown in the UI as the connected merchant
PAYPAL_MERCHANT_EMAIL=
# Development only. Refused when APP_ENV=production. Skips signature verification for simulator events.
PAYPAL_WEBHOOK_SKIP_VERIFY=false
# Sandbox buyer logins, used only by scripts/seed_sandbox.py for the browser-approval fallback. Never deployed.
PAYPAL_BUYER_US_EMAIL=
PAYPAL_BUYER_US_PASSWORD=
PAYPAL_BUYER_EU_EMAIL=
PAYPAL_BUYER_EU_PASSWORD=

# --- Channel3 ---
CHANNEL3_API_KEY=
CHANNEL3_API_BASE=https://api.trychannel3.com

# --- LLM providers ---
# Which provider the orchestrator uses first: openai | groq | gemini
LLM_PRIMARY_PROVIDER=openai
# Used automatically if the primary fails or is rate limited
LLM_FALLBACK_PROVIDER=gemini
# Optional: point the primary provider at any OpenAI-compatible base URL
LLM_BASE_URL_OVERRIDE=

OPENAI_API_KEY=
OPENAI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# --- Elastic (optional, leave empty to disable) ---
ELASTIC_URL=
ELASTIC_API_KEY=

# --- Frontend (Vite only exposes variables starting with VITE_) ---
# Safe to expose: the PayPal client ID is public by design. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
VITE_PAYPAL_CLIENT_ID=
