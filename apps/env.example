# MarginOS environment variables
# Copy this file to ".env" and fill in the values. Never commit ".env".

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
# Random long string, used to sign sessions. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-random-string

# --- Database ---
DATABASE_URL=postgresql+psycopg://marginos:marginos@localhost:5432/marginos
# Optional, only if a background worker is added
REDIS_URL=redis://localhost:6379/0

# --- PayPal (sandbox) ---
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=BAAqi_vBeXsl0eEKOJJZAJzQqNcEBPbsjoUi_M-CyLTlgl-8s8tmSXjD5TK6JyEBwLE-xTrx7F-_JE_Los
PAYPAL_CLIENT_SECRET=EM6AE4kj8voBtsMR12tyZblb8EnpZv-O9OE_4ZWH52R3pFEwQe1rqqyFLgF4QJIlIEUHPU-QdPzQfuy5
# Filled in after the webhook is registered (PayPal gives you this ID)
PAYPAL_WEBHOOK_ID=your-webhook-id
# Public URL PayPal posts events to (tunnel URL locally, Render URL in production)
PAYPAL_WEBHOOK_URL=https://your-public-url/webhooks/paypal
# Sandbox business account email, shown in the UI as the connected merchant
PAYPAL_MERCHANT_EMAIL=your-sandbox-business-email

# --- Channel3 ---
CHANNEL3_API_KEY=gbd4hE5MyBaESef0fzt7ia8uvUovN07e5AT7GB4l
CHANNEL3_API_BASE=https://api.trychannel3.com

# --- LLM providers ---
# Which provider the orchestrator uses first: openai | groq | gemini
LLM_PRIMARY_PROVIDER=openai
# Used automatically if the primary fails or is rate limited
LLM_FALLBACK_PROVIDER=gemini

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=model-name-here

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=model-name-here

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=model-name-here

# --- Elastic (optional, leave empty to disable) ---
ELASTIC_URL=
ELASTIC_API_KEY=

# --- Frontend (Vite only exposes variables starting with VITE_) ---
# Safe to expose: the PayPal client ID is public by design. Never put a secret in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8000
VITE_PAYPAL_CLIENT_ID=your-sandbox-client-id
